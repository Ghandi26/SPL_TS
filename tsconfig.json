{
  "compilerOptions": {
    "target": "es6",                 
    "module": "commonjs",            
    "lib": ["es2015", "dom"],        
    "strict": true,                  
    "esModuleInterop": true,         
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,            
    "outDir": "./dist"               
  },
  "include": ["src/**/*"],           
  "exclude": ["node_modules", "dist"]
}